# Puerto del servidor Express + Vite (por defecto 3000)
PORT=3000

# "production" activa cookies Secure y servir la build de Vite
NODE_ENV=development

# URL pública de la aplicación (usada en enlaces y cookies)
APP_URL=http://localhost:3000

# Clave de firma de sesiones. Si se omite, se genera y guarda en server/data/.session-secret
SESSION_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria

# Opcional: habilita el asistente de IA (Gemini)
GEMINI_API_KEY=

# TMDB API key for media lookup (get a free one at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Optional: a specific email that becomes owner on first Google login
# (leave empty to disable this bootstrap shortcut)
BOOTSTRAP_OWNER_EMAIL=

# Set to 'true' only when behind a trusted reverse proxy (e.g. Nginx, Heroku)
# that injects X-Forwarded-For. Leave false in development.
TRUSTED_PROXY=false
