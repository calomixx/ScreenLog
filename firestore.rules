rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Datos privados (biblioteca, preferencias): basta con estar autenticado.
    // Las acciones públicas (reseñas, catálogo, perfil público) sí exigen
    // email verificado mediante isOwner().
    function isAccountOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // SECURITY FIX: Removed hardcoded email from admin check.
    // Admin access is now determined solely by presence in /admins collection.
    function isAdmin() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 3. Entity Validation Blueprints
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'username', 'avatar', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'name', 'username', 'avatar', 'bio', 'city', 'favoriteGenres', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
        data.avatar is string && data.avatar.size() <= 1000 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 120)) &&
        (!('favoriteGenres' in data) || (
          data.favoriteGenres is list &&
          data.favoriteGenres.size() <= 10 &&
          (data.favoriteGenres.size() == 0 || (data.favoriteGenres[0] is string && data.favoriteGenres[0].size() <= 40))
        )) &&
        data.updatedAt == request.time;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'email', 'role', 'blocked', 'mustChangePassword', 'preferences', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('role' in data) || (data.role is string && data.role in ['user', 'admin', 'moderator', 'owner'])) &&
        (!('blocked' in data) || data.blocked is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidUserLibraryEntry(data) {
      return data.keys().hasAll(['userId', 'mediaId', 'status', 'personalRating', 'liked', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'userId', 'mediaId', 'status', 'personalRating', 'liked', 'createdAt', 'updatedAt',
          'rewatch', 'wouldRewatch', 'personalComment', 'watchedDate', 'watchPlatform',
          'favoriteMoment', 'scriptRating', 'actingRating', 'directionRating',
          'soundtrackRating', 'cinematographyRating', 'pacingRating', 'emotionalImpact',
          'shortVerdict', 'favoriteCharacter', 'quote', 'recommendation', 'moodRecommendation', 'tags'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.mediaId is string && data.mediaId.size() >= 1 && data.mediaId.size() <= 128 &&
        data.mediaId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['pendiente', 'en_proceso', 'terminada'] &&
        data.personalRating is number && data.personalRating >= 0 && data.personalRating <= 5 &&
        data.liked is bool &&
        (!('wouldRewatch' in data) || (data.wouldRewatch is string && data.wouldRewatch in ['si_totalmente', 'quizas', 'no_suficiente', 'jamas'])) &&
        (!('rewatch' in data) || (data.rewatch is string && data.rewatch in ['si', 'tal_vez', 'no', 'sin_definir'])) &&
        (!('personalComment' in data) || (data.personalComment is string && data.personalComment.size() <= 2000)) &&
        (!('watchedDate' in data) || (data.watchedDate is string && data.watchedDate.size() <= 30)) &&
        (!('watchPlatform' in data) || (data.watchPlatform is string && data.watchPlatform.size() <= 80)) &&
        (!('favoriteMoment' in data) || (data.favoriteMoment is string && data.favoriteMoment.size() <= 500)) &&
        (!('shortVerdict' in data) || (data.shortVerdict is string && data.shortVerdict.size() <= 200)) &&
        (!('favoriteCharacter' in data) || (data.favoriteCharacter is string && data.favoriteCharacter.size() <= 120)) &&
        (!('quote' in data) || (data.quote is string && data.quote.size() <= 300)) &&
        (!('recommendation' in data) || (data.recommendation is string && data.recommendation in ['si', 'quizas', 'no'])) &&
        (!('moodRecommendation' in data) || (data.moodRecommendation is string && data.moodRecommendation.size() <= 200)) &&
        (!('scriptRating' in data) || (data.scriptRating is number && data.scriptRating >= 1 && data.scriptRating <= 10)) &&
        (!('actingRating' in data) || (data.actingRating is number && data.actingRating >= 1 && data.actingRating <= 10)) &&
        (!('directionRating' in data) || (data.directionRating is number && data.directionRating >= 1 && data.directionRating <= 10)) &&
        (!('soundtrackRating' in data) || (data.soundtrackRating is number && data.soundtrackRating >= 1 && data.soundtrackRating <= 10)) &&
        (!('cinematographyRating' in data) || (data.cinematographyRating is number && data.cinematographyRating >= 1 && data.cinematographyRating <= 10)) &&
        (!('pacingRating' in data) || (data.pacingRating is number && data.pacingRating >= 1 && data.pacingRating <= 10)) &&
        (!('emotionalImpact' in data) || (data.emotionalImpact is number && data.emotionalImpact >= 1 && data.emotionalImpact <= 10)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidCommunityReview(data) {
      return data.keys().hasAll(['userId', 'mediaId', 'author', 'avatar', 'rating', 'comment', 'likes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'mediaId', 'author', 'avatar', 'rating', 'comment', 'likes', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.mediaId is string && data.mediaId.size() >= 1 && data.mediaId.size() <= 128 &&
        data.mediaId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 80 &&
        data.avatar is string && data.avatar.size() <= 1000 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 2000 &&
        data.likes is int && data.likes >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidCatalogMediaItem(data) {
      return data.keys().hasAll(['authorId', 'title', 'type', 'year', 'director', 'synopsis', 'posterUrl', 'backdropUrl', 'duration', 'defaultPlatform', 'genres', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'authorId', 'title', 'originalTitle', 'type', 'year', 'director', 'cast', 'synopsis',
          'posterUrl', 'backdropUrl', 'duration', 'defaultPlatform', 'genres', 'trailerYoutubeId',
          'trailerUrl', 'streamingPlatforms', 'communityRating', 'communityVotesCount',
          'addedToListCount', 'isFeatured', 'isTrending', 'isTopClassified', 'seasonsCount',
          'episodesCount', 'releaseDate', 'country', 'language', 'ageRating', 'status', 'tags',
          'createdByUserId', 'isCustomUserCreated', 'lastEditedBy', 'lastEditedAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.type is string && data.type.size() <= 20 &&
        data.type in ['pelicula', 'serie', 'anime', 'documental', 'novela'] &&
        data.year is int && data.year >= 1888 && data.year <= 2100 &&
        data.director is string && data.director.size() <= 120 &&
        data.synopsis is string && data.synopsis.size() <= 2000 &&
        data.posterUrl is string && data.posterUrl.size() <= 1000 &&
        data.backdropUrl is string && data.backdropUrl.size() <= 1000 &&
        data.duration is string && data.duration.size() <= 60 &&
        data.defaultPlatform is string && data.defaultPlatform.size() <= 80 &&
        data.genres is list && data.genres.size() >= 1 && data.genres.size() <= 10 &&
        data.genres[0] is string && data.genres[0].size() <= 40 &&
        (!('originalTitle' in data) || (data.originalTitle is string && data.originalTitle.size() <= 200)) &&
        (!('cast' in data) || (data.cast is list && data.cast.size() <= 20 && (data.cast.size() == 0 || data.cast[0] is string))) &&
        (!('trailerYoutubeId' in data) || (data.trailerYoutubeId is string && data.trailerYoutubeId.size() <= 120)) &&
        (!('trailerUrl' in data) || (data.trailerUrl is string && data.trailerUrl.size() <= 1000)) &&
        (!('streamingPlatforms' in data) || (data.streamingPlatforms is list && data.streamingPlatforms.size() <= 10 && (data.streamingPlatforms.size() == 0 || data.streamingPlatforms[0] is string))) &&
        (!('communityRating' in data) || (data.communityRating is number && data.communityRating >= 0 && data.communityRating <= 10)) &&
        (!('communityVotesCount' in data) || (data.communityVotesCount is int && data.communityVotesCount >= 0 && data.communityVotesCount <= 1000000)) &&
        (!('addedToListCount' in data) || (data.addedToListCount is int && data.addedToListCount >= 0 && data.addedToListCount <= 1000000)) &&
        (!('isFeatured' in data) || data.isFeatured is bool) &&
        (!('isTrending' in data) || data.isTrending is bool) &&
        (!('isTopClassified' in data) || data.isTopClassified is bool) &&
        (!('seasonsCount' in data) || (data.seasonsCount is int && data.seasonsCount >= 0 && data.seasonsCount <= 200)) &&
        (!('episodesCount' in data) || (data.episodesCount is int && data.episodesCount >= 0 && data.episodesCount <= 10000)) &&
        (!('releaseDate' in data) || (data.releaseDate is string && data.releaseDate.size() <= 30)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 80)) &&
        (!('ageRating' in data) || (data.ageRating is string && data.ageRating.size() <= 40)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 40)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 12 && (data.tags.size() == 0 || data.tags[0] is string))) &&
        (!('createdByUserId' in data) || (data.createdByUserId is string && data.createdByUserId.size() <= 128)) &&
        (!('isCustomUserCreated' in data) || data.isCustomUserCreated is bool) &&
        (!('lastEditedBy' in data) || (data.lastEditedBy is string && data.lastEditedBy.size() <= 128)) &&
        (!('lastEditedAt' in data) || (data.lastEditedAt is string && data.lastEditedAt.size() <= 40)) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidStringList(value, maxCount, maxLen) {
      return value is list &&
        value.size() <= maxCount &&
        (value.size() == 0 || (value[0] is string && value[0].size() <= maxLen));
    }

    // Cuenta privada del usuario: users/{uid}
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'preferences', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'preferences', 'legacyLibraryMigratedAt', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() <= 254 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        data.preferences is map &&
        data.preferences.keys().hasOnly(['theme', 'language', 'favoriteGenres', 'defaultStatus']) &&
        (!('theme' in data.preferences) || data.preferences.theme in ['dark', 'light', 'system']) &&
        (!('language' in data.preferences) || data.preferences.language in ['es', 'en']) &&
        (!('favoriteGenres' in data.preferences) || isValidStringList(data.preferences.favoriteGenres, 10, 40)) &&
        (!('defaultStatus' in data.preferences) || data.preferences.defaultStatus in ['pending', 'watching', 'watched', 'discarded']) &&
        (!('legacyLibraryMigratedAt' in data) || data.legacyLibraryMigratedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Clasificación personal: users/{uid}/movie_classifications/{movieId}
    function isValidMovieClassification(data, userId, movieId) {
      return data.keys().hasAll(['movieId', 'uid', 'status', 'isFavorite', 'rating', 'categories', 'tags', 'notes', 'schemaVersion', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'movieId', 'uid', 'status', 'isFavorite', 'rating', 'categories', 'tags', 'notes',
          'evaluation', 'watchedDate', 'platform', 'wouldRewatch', 'favoriteMoment',
          'shortVerdict', 'quote', 'recommendation', 'moodRecommendation', 'favoriteCharacter',
          'scriptRating', 'actingRating', 'directionRating', 'soundtrackRating',
          'cinematographyRating', 'pacingRating', 'emotionalImpact', 'schemaVersion',
          'createdAt', 'updatedAt'
        ]) &&
        data.movieId is string && data.movieId == movieId &&
        data.uid is string && data.uid == userId &&
        data.status in ['pending', 'watching', 'watched', 'discarded'] &&
        data.isFavorite is bool &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        isValidStringList(data.categories, 10, 40) &&
        isValidStringList(data.tags, 12, 40) &&
        data.notes is string && data.notes.size() <= 2000 &&
        (!('evaluation' in data) || (data.evaluation is string && data.evaluation.size() <= 60)) &&
        (!('watchedDate' in data) || (data.watchedDate is string && data.watchedDate.size() <= 10)) &&
        (!('platform' in data) || (data.platform is string && data.platform.size() <= 80)) &&
        (!('wouldRewatch' in data) || data.wouldRewatch in ['yes', 'maybe', 'no', 'unset']) &&
        (!('favoriteMoment' in data) || (data.favoriteMoment is string && data.favoriteMoment.size() <= 500)) &&
        (!('shortVerdict' in data) || (data.shortVerdict is string && data.shortVerdict.size() <= 160)) &&
        (!('quote' in data) || (data.quote is string && data.quote.size() <= 500)) &&
        (!('recommendation' in data) || data.recommendation in ['yes', 'maybe', 'no', '']) &&
        (!('moodRecommendation' in data) || (data.moodRecommendation is string && data.moodRecommendation.size() <= 200)) &&
        (!('favoriteCharacter' in data) || (data.favoriteCharacter is string && data.favoriteCharacter.size() <= 120)) &&
        (!('scriptRating' in data) || (data.scriptRating is number && data.scriptRating >= 0 && data.scriptRating <= 10)) &&
        (!('actingRating' in data) || (data.actingRating is number && data.actingRating >= 0 && data.actingRating <= 10)) &&
        (!('directionRating' in data) || (data.directionRating is number && data.directionRating >= 0 && data.directionRating <= 10)) &&
        (!('soundtrackRating' in data) || (data.soundtrackRating is number && data.soundtrackRating >= 0 && data.soundtrackRating <= 10)) &&
        (!('cinematographyRating' in data) || (data.cinematographyRating is number && data.cinematographyRating >= 0 && data.cinematographyRating <= 10)) &&
        (!('pacingRating' in data) || (data.pacingRating is number && data.pacingRating >= 0 && data.pacingRating <= 10)) &&
        (!('emotionalImpact' in data) || (data.emotionalImpact is number && data.emotionalImpact >= 0 && data.emotionalImpact <= 10)) &&
        data.schemaVersion is int && data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Lista personalizada: users/{uid}/lists/{listId}
    function isValidCustomList(data, userId, listId) {
      return data.keys().hasAll(['listId', 'uid', 'name', 'description', 'isPublic', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['listId', 'uid', 'name', 'description', 'isPublic', 'createdAt', 'updatedAt']) &&
        data.listId is string && data.listId == listId &&
        data.uid is string && data.uid == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.description is string && data.description.size() <= 500 &&
        data.isPublic is bool &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Elemento de lista: users/{uid}/lists/{listId}/items/{movieId}
    function isValidCustomListItem(data, movieId) {
      return data.keys().hasAll(['movieId', 'position', 'addedAt']) &&
        data.keys().hasOnly(['movieId', 'position', 'addedAt']) &&
        data.movieId is string && data.movieId == movieId &&
        data.position is int && data.position >= 0 && data.position <= 100000 &&
        data.addedAt is timestamp;
    }

    // 4. Collection Rules

    // Admins lookup collection (read-only for owner/admin, system-managed)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    // Public User Profiles (No PII)
    match /users_public/{userId} {
      allow get: if isValidId(userId) && existing().userId == userId;
      allow list: if isSignedIn() && existing().userId is string;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserPublicProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserPublicProfile(incoming(), userId) && (
        isAdmin() ||
        (
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'username', 'avatar', 'bio', 'city', 'favoriteGenres', 'updatedAt'])
        )
      );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Strictly isolated Private User Info (PII: email)
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // Isolated Private User PII Collection
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin()) &&
        exists(/databases/$(database)/documents/users_public/$(userId));
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && docId == 'info' &&
        isValidUserPrivateInfo(incoming(), userId) &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/users_public/$(userId));
      allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) && docId == 'info' &&
        isValidUserPrivateInfo(incoming(), userId) &&
        exists(/databases/$(database)/documents/users_public/$(userId)) && (
          isAdmin() ||
          (
            incoming().userId == existing().userId &&
            incoming().createdAt == existing().createdAt &&
            !incoming().diff(existing()).affectedKeys().hasAny(['role', 'blocked'])
          )
        );
      allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
    }

    // Cuenta privada + clasificaciones personales (solo el dueño)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAccountOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isAccountOwner(userId) && isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isAccountOwner(userId) && isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && (isAccountOwner(userId) || isAdmin());

      // Una clasificación por usuario y película: el ID del documento ES el movieId.
      match /movie_classifications/{movieId} {
        allow get: if isAccountOwner(userId) && isValidId(movieId);
        allow list: if isAccountOwner(userId);
        allow create: if isAccountOwner(userId) && isValidId(movieId) &&
          isValidMovieClassification(incoming(), userId, movieId) &&
          incoming().createdAt == request.time;
        allow update: if isAccountOwner(userId) && isValidId(movieId) &&
          isValidMovieClassification(incoming(), userId, movieId) &&
          existing().uid == userId && existing().movieId == movieId &&
          incoming().uid == existing().uid &&
          incoming().movieId == existing().movieId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isAccountOwner(userId) && isValidId(movieId);
      }

      // Listas personalizadas y sus elementos
      match /lists/{listId} {
        allow read: if isAccountOwner(userId) && isValidId(listId);
        allow create: if isAccountOwner(userId) && isValidId(listId) &&
          isValidCustomList(incoming(), userId, listId) &&
          incoming().createdAt == request.time;
        allow update: if isAccountOwner(userId) && isValidId(listId) &&
          isValidCustomList(incoming(), userId, listId) &&
          incoming().uid == existing().uid &&
          incoming().listId == existing().listId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isAccountOwner(userId) && isValidId(listId);

        match /items/{movieId} {
          allow read: if isAccountOwner(userId) && isValidId(movieId);
          allow create, update: if isAccountOwner(userId) && isValidId(movieId) &&
            isValidCustomListItem(incoming(), movieId);
          allow delete: if isAccountOwner(userId) && isValidId(movieId);
        }
      }
    }

    // Personal User Library Entries (colección legada; solo lectura/borrado para migrar)
    match /user_library/{entryId} {
      allow get: if isValidId(entryId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(entryId) &&
        isValidUserLibraryEntry(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users_public/$(request.auth.uid));
      allow update: if isVerifiedUser() && isValidId(entryId) &&
        isValidUserLibraryEntry(incoming()) && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().mediaId == existing().mediaId &&
            incoming().createdAt == existing().createdAt
          )
        );
      allow delete: if isValidId(entryId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Public Community Reviews
    match /community_reviews/{reviewId} {
      allow get: if isValidId(reviewId) && existing().rating >= 1;
      allow list: if existing().rating >= 1 && existing().rating <= 5;
      allow create: if isVerifiedUser() && isValidId(reviewId) &&
        isValidCommunityReview(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().likes == 0 &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users_public/$(request.auth.uid));
      allow update: if isVerifiedUser() && isValidId(reviewId) &&
        isValidCommunityReview(incoming()) && (
          isAdmin() ||
          // Action 1: Author edits their own review text or rating
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().mediaId == existing().mediaId &&
            incoming().createdAt == existing().createdAt &&
            incoming().likes == existing().likes &&
            incoming().diff(existing()).affectedKeys().hasOnly(['author', 'avatar', 'rating', 'comment', 'updatedAt'])
          ) ||
          // Action 2: Verified user increments/decrements likes by 1
          (
            incoming().userId == existing().userId &&
            incoming().mediaId == existing().mediaId &&
            incoming().author == existing().author &&
            incoming().avatar == existing().avatar &&
            incoming().rating == existing().rating &&
            incoming().comment == existing().comment &&
            incoming().createdAt == existing().createdAt &&
            (incoming().likes == existing().likes + 1 || incoming().likes == existing().likes - 1) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'updatedAt'])
          )
        );
      allow delete: if isValidId(reviewId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Shared Catalog Media Items
    match /catalog_media/{mediaId} {
      allow get: if isValidId(mediaId) && existing().year >= 1888;
      allow list: if existing().year >= 1888 && existing().year <= 2100;
      allow create: if isVerifiedUser() && isValidId(mediaId) &&
        isValidCatalogMediaItem(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users_public/$(request.auth.uid));
      allow update: if isVerifiedUser() && isValidId(mediaId) && (
        isAdmin() ||
        (
          isValidCatalogMediaItem(incoming()) &&
          existing().authorId == request.auth.uid &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt
        ) ||
        // Verified users can increment addedToListCount atomically
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['addedToListCount']) &&
          incoming().addedToListCount == existing().addedToListCount + 1
        )
      );
      allow delete: if isValidId(mediaId) && isAdmin();
    }
  }
}
